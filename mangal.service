# mangal serve as a systemd service: checks the watched mangas on a schedule (see the README,
# Headless). Copy it to /etc/systemd/system/, set User and the mangal path, then
#   systemctl enable --now mangal
# Logs: journalctl -u mangal. Another instance: a copy with ExecStart=... --config <file> serve.
[Unit]
Description=mangal serve (watched mangas)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=mangal
ExecStart=/usr/local/bin/mangal serve
Restart=on-failure
RestartSec=10s

# Hardening: providers are code (Lua scripts, scrapers driving a browser), keep what they
# can reach small. Drop a line if something of yours needs it (systemctl edit mangal).
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
# AF_NETLINK: Chrome (sites that need a browser) reads the network state through it
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# No MemoryDenyWriteExecute or RestrictNamespaces: Chrome's JIT and sandbox need them.

ProtectProc=invisible
RemoveIPC=yes
CapabilityBoundingSet=
SystemCallArchitectures=native

# Read-only system, other homes hidden: writable only the user's home (config, data, state,
# cache; rod downloads its browser to ~/.cache/rod) and the download path (download.path;
# set yours, one ReadWritePaths per dir mangal writes outside the home). A home outside
# /home (e.g. /opt/mangal): ProtectHome=yes, no BindPaths, the home in ReadWritePaths.
ProtectSystem=strict
ProtectHome=tmpfs
BindPaths=/home/mangal
ReadWritePaths=/srv/manga

# New files (downloads included) only readable by this user; leave it out if another user
# (a reader like Kavita or Komga) reads the library.
#UMask=0077

[Install]
WantedBy=multi-user.target
